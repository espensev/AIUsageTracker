<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="8.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.analyzers" Version="1.27.0" PrivateAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Codeuctivity.ImageSharpCompare" Version="4.1.379" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIUsageTracker.Infrastructure\AIUsageTracker.Infrastructure.csproj" />
    <ProjectReference Include="..\AIUsageTracker.Core\AIUsageTracker.Core.csproj" />
    <ProjectReference Include="..\AIUsageTracker.Monitor\AIUsageTracker.Monitor.csproj" />
    <ProjectReference Include="..\AIUsageTracker.UI.Slim\AIUsageTracker.UI.Slim.csproj" />
    <ProjectReference Include="..\AIUsageTracker.Web\AIUsageTracker.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="TestData\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\AIUsageTracker.UI.Slim\MainWindow.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\UI\MainWindow.xaml</Link>
    </Content>
    <Content Include="..\AIUsageTracker.UI.Slim\Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Source guardrails and appcast checks run from the downloaded test artifact. -->
  <ItemGroup>
    <Content Include="..\**\*.cs;..\**\*.cshtml"
             Exclude="..\artifacts\**;..\dist\**;..\**\bin\**;..\**\obj\**;..\**\bin_unlocked\**;..\**\bin_unlocked_ui\**;..\**\TempBin\**">
      <Link>TestData\Repository\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Directory.Build.props" Link="TestData\Repository\Directory.Build.props" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\appcast\*.xml" Link="TestData\Repository\appcast\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\AIUsageTracker.Monitor\openapi.yaml" Link="TestData\Repository\AIUsageTracker.Monitor\openapi.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\scripts\generate-appcast.sh" Link="TestData\Repository\scripts\generate-appcast.sh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
