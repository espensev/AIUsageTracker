<Window x:Class="AIUsageTracker.UI.Slim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AIUsageTracker.UI.Slim.ViewModels"
        xmlns:converters="clr-namespace:AIUsageTracker.UI.Slim.Converters"
        mc:Ignorable="d"
        Title="AI Usage Tracker" Height="400" Width="380"
        MinWidth="320" MinHeight="300"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Background}"
        Foreground="{DynamicResource PrimaryText}"
        ShowInTaskbar="False"
        Topmost="False"
        Icon="Assets/app_icon.ico"
        KeyDown="OnKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ActionFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource PrimaryText}" BorderThickness="1" Margin="2" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource ActionFocusVisual}"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Compact Header -->
            <Border x:Name="HeaderBorder" Background="{DynamicResource HeaderBackground}" Padding="8,6" Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/app_icon.ico" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="AI Usage Tracker" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Grid.Column="1" Text="v..." FontSize="10" Foreground="{DynamicResource TertiaryText}" VerticalAlignment="Center" Margin="6,1,4,0" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="PrivacyBtn" Content="&#xE785;" Click="PrivacyBtn_Click" Background="Transparent" Foreground="{DynamicResource SecondaryText}" Width="32" Height="32" Margin="0,0,4,0" ToolTip="Toggle Privacy Mode (Ctrl+P)" AutomationProperties.Name="Turn on privacy mode" FontFamily="Segoe MDL2 Assets" FontSize="14" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="&#xE8BB;" Click="CloseBtn_Click" Background="Transparent" Foreground="{DynamicResource SecondaryText}" Width="32" Height="32" FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="Hide to tray (Escape)" AutomationProperties.Name="Hide to tray" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Update Notification (hidden by default) -->
            <Border x:Name="UpdateNotificationBanner" Grid.Row="1" Background="{DynamicResource AccentColor}" Padding="6,3" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock x:Name="UpdateText" Text="Update available!" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Changelog" HorizontalAlignment="Right" Click="ViewChangelogBtn_Click" Background="{DynamicResource ButtonBackground}" Foreground="White" FontSize="10" Padding="6,2" Margin="8,0,0,0" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="Download" HorizontalAlignment="Right" Click="UpdateBtn_Click" Background="{DynamicResource ButtonBackground}" Foreground="White" FontSize="10" Padding="6,2" Margin="8,0,0,0" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Provider List - No padding for compact view -->
            <ScrollViewer x:Name="ProvidersScrollViewer" Grid.Row="2" Padding="6,4" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ProvidersList">
                    <TextBlock Text="Loading..." Foreground="{DynamicResource TertiaryText}" HorizontalAlignment="Center" FontSize="11"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Compact Footer -->
            <Border x:Name="FooterBorder" Grid.Row="3" Background="{DynamicResource FooterBackground}" Padding="8,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,4">
                        <!-- Status LED Indicator -->
                        <Ellipse x:Name="StatusLed" Width="8" Height="8" Fill="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0"
                                 ToolTip="Last update: Never"/>
                        <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="Last update: Never" AutomationProperties.LiveSetting="Polite"/>
                    </DockPanel>
                    <DockPanel Grid.Row="1" LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <CheckBox x:Name="AlwaysOnTopCheck"
                                      Content="Top"
                                      IsChecked="False"
                                      Foreground="{DynamicResource SecondaryText}"
                                      VerticalAlignment="Center"
                                      FontSize="11"
                                      MinHeight="32"
                                      Margin="0,0,8,0"
                                      ToolTip="Keep this window on top"
                                      AutomationProperties.Name="Always on top"
                                      Checked="AlwaysOnTop_Checked"
                                      Unchecked="AlwaysOnTop_Checked"/>
                            <CheckBox x:Name="ShowUsedToggle"
                                      Content="Show used"
                                      Foreground="{DynamicResource SecondaryText}"
                                      VerticalAlignment="Center"
                                      FontSize="11"
                                      MinHeight="32"
                                      Margin="0,0,8,0"
                                      ToolTip="Show used percentages instead of remaining percentages"
                                      AutomationProperties.Name="Show used percentages"
                                      Checked="ShowUsedToggle_Checked"
                                      Unchecked="ShowUsedToggle_Checked"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="RefreshBtn" Click="RefreshBtn_Click" Margin="0,0,4,0" ToolTip="Refresh (Ctrl+R)" AutomationProperties.Name="Refresh usage" Width="32" Height="32">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="WebBtn" Click="WebBtn_Click" Margin="0,0,4,0" ToolTip="Open Web UI" AutomationProperties.Name="Open Web UI" Width="32" Height="32">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="MonitorToggleBtn" Click="MonitorToggleBtn_Click" ToolTip="Start Monitor" AutomationProperties.Name="Start Monitor" Width="32" Height="32">
                                <TextBlock x:Name="MonitorToggleIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="SettingsBtn" Click="SettingsBtn_Click" Margin="4,0,0,0" ToolTip="Settings (F2)" AutomationProperties.Name="Open settings" Width="32" Height="32">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
